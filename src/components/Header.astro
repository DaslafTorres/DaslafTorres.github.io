---
import { copy, homePath, otherLang, type Lang } from "../data/site";

interface Props {
  lang: Lang;
  altPath: string;
}

const { lang, altPath } = Astro.props;
const c = copy[lang];
const home = homePath(lang);
const alternate = otherLang(lang);
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href={home}>
      <span class="brand-dot" aria-hidden="true"></span>
      Daslaf Torres
    </a>
    <nav class="site-nav" aria-label={c.nav.label}>
      <span class="nav-links">
        <a href={`${home}#work`}>{c.nav.work}</a>
        <a href={`${home}#about`}>{c.nav.about}</a>
        <a href={`${home}#contact`}>{c.nav.contact}</a>
      </span>
      <span class="lang-switch" role="group" aria-label="Language">
        {alternate === "en" ? (
          <a href={altPath} lang="en" hreflang="en">
            EN
          </a>
        ) : (
          <span class="active" aria-current="true">
            EN
          </span>
        )}
        {alternate === "es" ? (
          <a href={altPath} lang="es" hreflang="es">
            ES
          </a>
        ) : (
          <span class="active" aria-current="true">
            ES
          </span>
        )}
      </span>
    </nav>
  </div>
</header>
